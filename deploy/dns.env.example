# Beispiel für dns.env – API-Token für die DNS-Challenge (HTTPS).
# Kopieren nach  dns.env , Token eintragen, Rechte streng setzen:
#   cp dns.env.example dns.env && chmod 600 dns.env
# Die echte Datei dns.env gehört NICHT ins Repo (ist per .gitignore ausgeschlossen).

# Token mit Berechtigung, TXT-Records der betreffenden DNS-Zone zu bearbeiten.
DNS_API_TOKEN=hier_das_api_token_eintragen
